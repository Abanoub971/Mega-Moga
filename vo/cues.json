[
  {
    "id": "01",
    "start": 1.4,
    "end": 4.2,
    "text": "يَبْدَأُ الطَّرِيقُ… بِالإِيمَان."
  },
  {
    "id": "02",
    "start": 4.8,
    "end": 8.6,
    "text": "وَيُبْنَى بِالمَعْرِفَة: مَكْتَبَةٌ تَعْلِيمِيَّة، وَمَدْرَسَةٌ أُونْلَايْن."
  },
  {
    "id": "03",
    "start": 10.3,
    "end": 13.6,
    "text": "يَجْمَعُ مَنْ يَبْدَأُ الطَّرِيق… وَمَنْ يَخْدِمُ فِيه."
  },
  {
    "id": "04",
    "start": 14.1,
    "end": 16.6,
    "text": "وَيَمْتَدُّ… إِلَى مَنْ يُدَاوِي."
  },
  {
    "id": "05",
    "start": 19.4,
    "end": 21.35,
    "text": "حَتَّى يَصِيرَ اسْتِعْدَادًا لِلْخِدْمَة."
  },
  {
    "id": "06",
    "start": 25.4,
    "end": 27.4,
    "text": "خِدْمَةُ القِدِّيسِ بُولُس القِبْطِيَّة."
  },
  {
    "id": "07",
    "start": 27.6,
    "end": 29.4,
    "text": "«مُفَصِّلًا كَلِمَةَ الحَقِّ… بِالاسْتِقَامَة»."
  }
]